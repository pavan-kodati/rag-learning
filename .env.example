# Copy to .env.  Every value has a working default; this file documents the knobs.

# --- database (matches `docker compose up db`) ---
DATABASE_URL=postgresql://lw:lw@localhost:5432/legal_workspace

# --- models: all open source, run locally via Ollama (no cost) ---
LLM_PROVIDER=ollama               # ollama | openai_compat (vLLM etc.) | fixture (demo without any model)
OLLAMA_BASE_URL=http://localhost:11434
LLM_MAIN_MODEL=qwen3:8b           # ~5 GB download. On a small laptop use qwen3:4b
LLM_FAST_MODEL=qwen3:4b           # ~2.5 GB
LLM_CONTEXT_MAIN=16384            # lower to 8192 if memory is tight
EMBEDDER=ollama                   # ollama (bge-m3) | hashing (offline, lower quality)
EMBEDDING_MODEL=bge-m3            # ~1.2 GB, 1024-d
RERANKER=none                     # none | cross_encoder (needs: pip install ".[rerank]", downloads ~2 GB)

# --- behaviour ---
EMBEDDED_WORKER=true              # run ingestion inside the API process (single-process local dev)
WORKSPACE_TODAY=                  # e.g. 2025-09-20 to demo "overdue" on the synthetic matters
AUTH_ENABLED=false
STORAGE_DIR=./storage
