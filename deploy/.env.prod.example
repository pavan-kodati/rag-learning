# cp deploy/.env.prod.example deploy/.env.prod  and fill in. Never commit the real file (.gitignore covers it).
PUBLIC_HOST=legal.example.com
POSTGRES_PASSWORD=change-me-long-random
JWT_SECRET=change-me-64-random-chars
AUTH_USERS=alice:a-strong-password:admin,bob:another-password:analyst
LLM_PROVIDER=ollama               # or openai_compat (vLLM on a GPU host)
OLLAMA_BASE_URL=http://host.docker.internal:11434
WORKER_REPLICAS=1
