# cp deploy/.env.prod.example deploy/.env.prod   then edit.  Never commit the real file (.gitignore covers it).
# Use only letters, digits, - and _ in passwords/secrets (generate with:  openssl rand -hex 24 ).
# Your site address. With a domain: legal.example.com   Without one: <your-elastic-ip-with-dashes>.sslip.io  (e.g. 3-110-20-5.sslip.io)
PUBLIC_HOST=legal.example.com
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me
# user:password:role, comma-separated. Roles: viewer < analyst < admin
AUTH_USERS=admin:change-me:admin

# --- models (open source, run in the bundled Ollama container on the same machine) ---
LLM_PROVIDER=ollama
EMBEDDER=ollama
LLM_MAIN_MODEL=qwen3:8b           # on a CPU-only box use qwen3:4b
LLM_FAST_MODEL=qwen3:4b
EMBEDDING_MODEL=bge-m3
# Demo only (no models, only knows the built-in synthetic matters):  LLM_PROVIDER=fixture  EMBEDDER=hashing

WORKER_REPLICAS=1
